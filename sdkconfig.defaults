# ESP32-P4 Wi-Fi Remote Configuration for ESP32-P4-Function-EV-Board
# This board has ESP32-C6-MINI-1 as WiFi co-processor via SDIO

# Slave (ESP32-C6) target selection
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y

# ESP32-P4 Function EV Board specific SDIO configuration
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y

# WiFi Remote buffer configuration for performance
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32

# TCP/IP Performance
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

CONFIG_LWIP_TCP_SACK_OUT=y

# HTTPS/TLS Support for LLM API
CONFIG_ESP_TLS_ENABLED=y
CONFIG_ESP_TLS_WITH_MBEDTLS=y
CONFIG_MBEDTLS_SSL_MAX_CONTENT_LEN=4096

# mbedtls 使用内部 SRAM（更快），PSRAM 延迟会影响 TLS 加解密速度
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# 启用 TLS 1.2 和 TLS 1.3 支持
CONFIG_MBEDTLS_SSL_PROTO_TLS1_2=y
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y

# Certificate bundle for HTTPS
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y

# HTTP Client
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y

# JSON Support
CONFIG_JSON_ENABLE_STRING_AUTO_ESCAPE=n

# Allow task stacks in PSRAM to save internal RAM
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y


# Task Watchdog Timer timeout set to 60 seconds
CONFIG_ESP_TASK_WDT_TIMEOUT_S=60

# LVGL 拼音输入法
CONFIG_LV_USE_IME_PINYIN=y
CONFIG_LV_IME_PINYIN_USE_DEFAULT_DICT=n
CONFIG_LV_IME_PINYIN_CAND_TEXT_NUM=8

# 禁用 BSP 错误检查，避免 SD 卡或触摸屏初始化失败导致崩溃
# 触摸屏和 SD 卡初始化失败时仅返回错误码，不触发断言
CONFIG_BSP_ERROR_CHECK=n

# Camera sensor: OV5647 (800x800 RAW8 50fps)
CONFIG_CAMERA_OV5647=y
CONFIG_CAMERA_OV5647_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV5647_MIPI_RAW8_800X800_50FPS=y
CONFIG_CAMERA_OV5647_MIPI_DEFAULT_FMT_RAW8_800X800_50FPS=y
CONFIG_CAMERA_OV5647_CSI_LINESYNC_ENABLE=y
CONFIG_CAMERA_OV5647_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE=y
CONFIG_CAMERA_OV5647_CUSTOMIZED_IPA_JSON_CONFIGURATION_FILE_PATH="who_components/who_peripherals/who_cam/who_p4_cam/ov5647.json"


